# Copy to .env.local for local development. Never put secrets here:
# NEXT_PUBLIC_* values are shipped to the browser.

# Server-side base URL (container DNS name in Docker Compose).
API_URL=http://localhost:4000/api/v1

# Browser-visible base URL. Must be the public API origin in cloud deployments.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
