# Local API configuration. Copy to .env; never commit real secrets.
# SQLite keeps local development working without a database server.
DB_DRIVER=sqlite
SQLITE_PATH=./data/sharebasket.sqlite

# PostgreSQL (Docker/Render). Set DB_DRIVER=postgres to use it.
# DATABASE_URL=postgres://sharebasket:sharebasket@localhost:5432/sharebasket
# DATABASE_SSL=false

PORT=4000
NODE_ENV=development

# Browser origins allowed to call the API (comma separated, no wildcard).
CORS_ORIGINS=http://localhost:3000

# Opt-in automation for container/demo boots. Keep false in real production.
MIGRATE_ON_BOOT=false
SEED_ON_BOOT=false
SEED_ALLOW_PRODUCTION=false

# Sessions. Required in production (32+ characters); generate with:
#   openssl rand -base64 48
AUTH_SECRET=development-only-session-secret-change-me-32
# Public origin of the web app. OAuth redirects point here.
PUBLIC_WEB_URL=http://localhost:3000

# Optional OAuth. Set both values of a provider to enable its button.
# Google: https://<web-origin>/api/backend/auth/google/callback
# GitHub: https://<web-origin>/api/backend/auth/github/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
