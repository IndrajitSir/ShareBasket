# Local API configuration. Copy to .env; never commit real secrets.
# SQLite keeps local development working without a database server.
DB_DRIVER=sqlite
SQLITE_PATH=./data/sharebasket.sqlite

# PostgreSQL (Docker/Render). Set DB_DRIVER=postgres to use it.
# DATABASE_URL=postgres://sharebasket:sharebasket@localhost:5432/sharebasket
# DATABASE_SSL=false

PORT=4000
NODE_ENV=development

# Browser origins allowed to call the API (comma separated, no wildcard).
CORS_ORIGINS=http://localhost:3000

# Opt-in automation for container/demo boots. Keep false in real production.
MIGRATE_ON_BOOT=false
SEED_ON_BOOT=false
SEED_ALLOW_PRODUCTION=false
